# Vite requires client-accessible variables to be prefixed with VITE_
# In local development:
VITE_API_URL=http://localhost:5000/api

# In production (e.g. Render / Vercel / Netlify):
# Set this in your hosting provider's Environment Variables dashboard:
# VITE_API_URL=https://your-backend-api.onrender.com/api
