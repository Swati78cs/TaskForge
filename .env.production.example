# Application Configuration
NODE_ENV=production
PORT=5000
CLIENT_URL=https://your-taskforge-client.onrender.com

# Database Connection (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/TaskForge?retryWrites=true&w=majority

# Redis Cache & BullMQ Queue (Render Redis or Upstash)
REDIS_URL=redis://red-xxxxxxxxxxxx:6379
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Security & Authentication (JWT)
JWT_SECRET=your_super_strong_jwt_access_secret_min_32_characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_strong_jwt_refresh_secret_min_32_characters
JWT_REFRESH_EXPIRES_IN=7d

# Worker Settings
WORKER_CONCURRENCY=5
LOCK_DURATION=30000

# Standalone / Single Service Deployment Flags for Render Free Tier:
RUN_WORKER_IN_SERVER=true
RUN_SCHEDULER_IN_SERVER=true

# Email Service Credentials (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=TaskForge <onboarding@resend.dev>
